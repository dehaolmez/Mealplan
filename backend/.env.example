# Veritabanı (varsayılan SQLite). PostgreSQL için: postgresql+psycopg://user:pass@localhost/mealbird
MEALBIRD_DATABASE_URL=sqlite:///./meall.db
# Açılışta otomatik migrasyon (eski şemalı SQLite dosyası yedeklenip yenilenir)
MEALBIRD_AUTO_MIGRATE=true
MEALBIRD_SEED_ON_STARTUP=true
# Canlı fiyat: TÜBİTAK Market Fiyatı (kamuya açık). Kapatılırsa CSV/demo fiyatlar kullanılır.
MEALBIRD_LIVE_PRICES_ENABLED=true
MEALBIRD_LIVE_PRICES_TTL_HOURS=12
MEALBIRD_LIVE_PRICES_PREFETCH_PILOT=true
# Pilot bölge için "test" etiketli üretilmiş fiyatlar (canlı fiyat çalıştığı için varsayılan kapalı)
MEALBIRD_LOAD_TEST_PRICES=false
# Derlenmiş arayüzü API ile aynı adresten sun (Docker imajında /app/static)
MEALBIRD_STATIC_DIR=

# Oturum. Üretimde mutlaka uzun rastgele bir değer verin (boşsa backend/.secret_key üretilir).
MEALBIRD_SECRET_KEY=
MEALBIRD_COOKIE_SECURE=false
MEALBIRD_PUBLIC_BASE_URL=http://localhost:5173

# İlk açılışta yoksa oluşturulacak yönetici hesabı (şifre değiştirilmez; yalnız ilk kurulum içindir).
# Alternatif: python -m app.cli create-admin eposta@ornek.com --generate
MEALBIRD_ADMIN_EMAIL=
MEALBIRD_ADMIN_PASSWORD=

# Google ile giriş: Google Cloud Console > API'ler ve Hizmetler > Kimlik bilgileri > OAuth istemci kimliği (Web)
MEALBIRD_GOOGLE_CLIENT_ID=

# E-posta (doğrulama, şifre sıfırlama). Boşsa e-postalar sunucu günlüğüne yazılır.
# Gmail için: smtp.gmail.com + uygulama şifresi (docs/DEPLOY.md, Adım 4)
MEALBIRD_SMTP_HOST=
MEALBIRD_SMTP_PORT=587
MEALBIRD_SMTP_USER=
MEALBIRD_SMTP_PASSWORD=
MEALBIRD_SMTP_FROM=Meall <no-reply@ornek.com>

# Konum: dış servise giden/saklanan hassasiyet (4 ondalık ≈ 11 m)
MEALBIRD_LOCATION_PRECISION=4
MEALBIRD_PILOT_NAME=Ankara, Etimesgut
MEALBIRD_PILOT_LAT=39.9496
MEALBIRD_PILOT_LON=32.6618

# SKT uyarı eşikleri (gün)
MEALBIRD_EXPIRY_CRITICAL_DAYS=1
MEALBIRD_EXPIRY_WARNING_DAYS=3

# Yapay zekâ (fiş okuma + öneri). Varsayılan sağlayıcı Gemini.
MEALBIRD_AI_ENABLED=true
MEALBIRD_AI_PROVIDER=gemini
MEALBIRD_GEMINI_API_KEY=
MEALBIRD_GEMINI_MODELS=["gemini-3.8-flash","gemini-3.5-flash","gemini-3.1-flash-lite"]
# Claude kullanmak için: MEALBIRD_AI_PROVIDER=claude ve ANTHROPIC_API_KEY
MEALBIRD_AI_MODEL=claude-opus-5-5
MEALBIRD_AI_EFFORT=medium
